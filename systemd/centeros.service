[Unit]
Description=CenterOS Dashboard (Proxmox LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/centeros/dashboard
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /opt/centeros/dashboard
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
