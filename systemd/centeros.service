[Unit]
Description=CenterOS Dashboard (Proxmox LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/centeros
ExecStart=/usr/bin/python3 /opt/centeros/server.py --root /opt/centeros --port 8080 --bind 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
